APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://quantlab@localhost:5432/quantlab
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# Vytvořte pouze lokálně pomocí `make generate-dev-secrets`; hodnoty necommitujte.
API_VIEWER_TOKEN=
API_OPERATOR_TOKEN=
API_ADMIN_TOKEN=
QUANTLAB_API_VIEWER_TOKEN=
QUANTLAB_API_OPERATOR_TOKEN=
QUANTLAB_API_ADMIN_TOKEN=
SESSION_SECRET=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_SCRYPT=
OPERATOR_ROLE=ADMIN
SESSION_MAX_AGE_SECONDS=3600
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
AUTOMATION_ENABLED=false
WORKER_POLL_INTERVAL=5
WORKER_LEASE_TIMEOUT=60
WORKER_HEARTBEAT_INTERVAL=15
JOB_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=5
RETRY_MAX_DELAY=300
MARKET_DATA_PROVIDER=stooq
# Alpaca Basic/Paper market-data podporuje IEX; jiný feed nastavte pouze explicitně.
ALPACA_FEED=iex
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
MARKET_DATA_TIMEOUT=10
MARKET_DATA_MAX_ATTEMPTS=3
MARKET_DATA_SYNC_OVERLAP=5
MARKET_DATA_CALENDAR=XNYS
MARKET_DATA_MINIMUM_COVERAGE=0.98
MARKET_DATA_STALENESS_POLICY=1
