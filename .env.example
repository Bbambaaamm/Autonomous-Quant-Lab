APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://quantlab@localhost:5432/quantlab
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
AUTOMATION_ENABLED=false
WORKER_POLL_INTERVAL=5
WORKER_LEASE_TIMEOUT=60
WORKER_HEARTBEAT_INTERVAL=15
JOB_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=5
RETRY_MAX_DELAY=300
