{
  "version": 2,
  "v2": {
    "maxFixCommits": 2,
    "maxPatchFiles": 12,
    "maxPatchBytes": 131072,
    "codexSecret": "OPENAI_API_KEY",
    "reviewMarker": "agent-codex-review:v2",
    "fixMarker": "agent-fix:v2",
    "fixableCiJobs": ["agent-pipeline", "quality", "unit-research", "api", "frontend"],
    "prohibitedCiJobs": ["security", "integration-postgres", "container-build", "production-smoke"],
    "deniedPathPrefixes": [".github/", "docs/ROADMAP.md", "backend/alembic/", "backend/src/quantlab/api/auth", "deploy/", "infra/"],
    "deniedPathBasenames": ["AGENTS.md", "package.json", "package-lock.json", "pyproject.toml", "uv.lock"],
    "deniedPathFragments": ["migration", "schema", "secret", "credential", "broker", "execution", "live"]
  },
  "implementationLabel": "type:implementation",
  "epicLabels": ["type:epic", "type:roadmap", "type:capability"],
  "stateLabels": [
    "agent:ready",
    "agent:running",
    "agent:pr",
    "agent:needs-human",
    "agent:verified"
  ],
  "requiredCiJobs": [
    "agent-pipeline",
    "quality",
    "unit-research",
    "api",
    "integration-postgres",
    "frontend",
    "security",
    "container-build",
    "production-smoke"
  ]
}
