#!/usr/bin/env python3
import fcntl
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path("/home/agentops")
WORKER = HOME / ".local/bin/agent-task-worker"
ROOT = HOME / ".local/state/agent-stack/tasks"
PENDING = ROOT / "pending"
RUNNING = ROOT / "running"
LOG = HOME / ".local/state/agent-stack/task-dispatch.log"
DISPATCH_LOCK = ROOT / "dispatcher.lock"

ENV = os.environ.copy()
ENV["HOME"] = str(HOME)
ENV["PATH"] = f"{HOME}/.local/node24/bin:{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"

def log(message: str) -> None:
    line = f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} {message}"
    with LOG.open("a", encoding="utf-8") as handle:
        handle.write(line + "\n")

def parse_time(value: str | None) -> datetime:
    if not value:
        return datetime.min.replace(tzinfo=timezone.utc)
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc)

def worker_running() -> bool:
    # Process check closes the race between Popen() and the worker acquiring worker.lock.
    proc = subprocess.run(
        ["/usr/bin/pgrep", "-f", "[a]gent-task-worker"],
        text=True,
        capture_output=True,
        env=ENV,
    )
    if proc.returncode == 0:
        return True
    lock = ROOT / "worker.lock"
    proc = subprocess.run(
        ["/usr/bin/flock", "-n", str(lock), "-c", "true"],
        text=True,
        capture_output=True,
        env=ENV,
    )
    return proc.returncode != 0

def due_tasks() -> list[Path]:
    current = datetime.now(timezone.utc)
    due: list[tuple[int, datetime, Path]] = []
    for path in sorted(PENDING.glob("*.json")):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            when = parse_time(data.get("not_before"))
            priority = int(data.get("priority", 50))
        except Exception as exc:
            log(f"invalid task {path.name}: {exc}")
            continue
        if when <= current:
            due.append((priority, when, path))
    return [path for _, _, path in sorted(due, key=lambda item: (item[0], item[1], item[2].name))]

def launch(path: Path, dry_run: bool = False) -> int:
    if dry_run:
        print(path)
        return 0
    if worker_running():
        log("worker already active")
        return 0

    task = json.loads(path.read_text(encoding="utf-8"))
    task_id = str(task["id"])
    running = RUNNING / f"{task_id}.json"
    if running.exists():
        log(f"refuse duplicate running task {task_id}")
        return 1

    os.replace(path, running)
    log(f"launch {task_id} priority={task.get('priority', 50)}")
    with (ROOT / "logs" / f"{task_id}.launcher.log").open("ab") as handle:
        proc = subprocess.Popen(
            [str(WORKER), str(running)],
            stdout=handle,
            stderr=subprocess.STDOUT,
            env=ENV,
            start_new_session=True,
        )

    # Do not release the dispatcher serialization window until the child is
    # observable or has already settled. This prevents a second task from
    # being launched during worker.lock acquisition.
    for _ in range(50):
        if worker_running():
            return 0
        if proc.poll() is not None:
            log(f"worker for {task_id} settled before lock observation rc={proc.returncode}")
            return 0
        time.sleep(0.1)
    log(f"worker process for {task_id} alive; lock acquisition not observed after 5s")
    return 0

def main() -> int:
    dry_run = "--dry-run" in sys.argv
    lock_fd = os.open(DISPATCH_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        tasks = due_tasks()
        if not tasks:
            return 0
        return launch(tasks[0], dry_run=dry_run)
    finally:
        os.close(lock_fd)

if __name__ == "__main__":
    raise SystemExit(main())
