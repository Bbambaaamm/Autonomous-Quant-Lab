[Unit]
Description=Hermes maintenance and encrypted off-site backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agentops
Group=agentops
Environment=HOME=/home/agentops
Environment=PATH=/home/agentops/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/agentops/.local/bin/hermes-maintenance