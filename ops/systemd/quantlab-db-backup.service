[Unit]
Description=QuantLab daily PostgreSQL backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=BACKUP_DIR=/home/quantadmin/quantlab-backups
Environment=BACKUP_RETENTION_DAYS=14
Environment=BACKUP_PREFIX=quantlab-daily
ExecStart=/bin/sh /home/quantadmin/apps/quantlab-staging/scripts/staging-db-backup.sh
